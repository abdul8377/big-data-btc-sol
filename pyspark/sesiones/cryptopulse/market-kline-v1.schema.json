{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cryptopulse:market-kline:v1",
  "title": "CryptoPulse closed spot kline v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "symbol",
    "interval",
    "open_ms",
    "close_ms",
    "event_time",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "quote_asset_volume",
    "number_of_trades",
    "is_closed",
    "source",
    "source_mode",
    "transport",
    "published_ms",
    "synthetic"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_type": {
      "const": "market.candle.closed"
    },
    "event_id": {
      "type": "string",
      "pattern": "^(BTCUSDT|SOLUSDT):1m:[0-9]+$"
    },
    "symbol": {
      "enum": [
        "BTCUSDT",
        "SOLUSDT"
      ]
    },
    "interval": {
      "const": "1m"
    },
    "open_ms": {
      "type": "integer",
      "minimum": 0
    },
    "close_ms": {
      "type": "integer",
      "minimum": 0
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "number_of_trades": {
      "type": "integer",
      "minimum": 0
    },
    "is_closed": {
      "const": true
    },
    "source": {
      "const": "binance_spot"
    },
    "source_mode": {
      "enum": [
        "live",
        "backfill",
        "replay"
      ]
    },
    "transport": {
      "enum": [
        "websocket",
        "rest",
        "replay"
      ]
    },
    "published_ms": {
      "type": "integer",
      "minimum": 0
    },
    "synthetic": {
      "const": false
    },
    "open": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "high": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "low": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "close": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "volume": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "quote_asset_volume": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    }
  },
  "additionalProperties": false
}